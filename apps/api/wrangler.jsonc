{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hav-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hav-db",
      // 실제 id 는 사람이 `wrangler d1 create hav-db` 로 만든 뒤 넣는다 — 로컬 개발은 이 값 그대로 동작
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "triggers": {
    // 환율: 수출입은행 영업일 11시 전후 갱신 → 평일 12:00 KST (03:00 UTC)
    // 물가: 세계은행 연 단위 자료 → 매달 1일 13:00 KST (04:00 UTC)
    // src/index.ts CRON 과 같은 문자열이어야 함 (index.test.ts 가 검사)
    "crons": ["0 3 * * 1-5", "0 4 1 * *"]
  },
  "observability": { "enabled": true }
}
