{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // 배포 주소: tripfx-api.developfff.workers.dev (2026-10-28 사용자 결정)
  "name": "tripfx-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // 무료 주소 tripfx-api.developfff.workers.dev 를 씀 (배포 때 기본값 경고가 나와서 명시) · 버전별 미리보기 주소는 끔
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hav-db",
      // 사용자가 `wrangler d1 create hav-db` 로 만든 실제 DB (2026-10-28) — 비밀값 아님 · 로컬 개발은 --local 로 따로
      "database_id": "eccde06e-211e-4eb0-95e5-c0c30f8ad278",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "triggers": {
    // 환율: 수출입은행 영업일 11시 전후 갱신 → 평일 12:00 KST (03:00 UTC)
    // 물가: 세계은행 연 단위 자료 → 매달 1일 13:00 KST (04:00 UTC)
    // src/index.ts CRON 과 같은 문자열이어야 함 (index.test.ts 가 검사)
    "crons": ["0 3 * * 1-5", "0 4 1 * *"]
  },
  "observability": { "enabled": true }
}
