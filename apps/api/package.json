    "@hav/config": "*",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@hav/shared": "^0.0.0",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  }
}
